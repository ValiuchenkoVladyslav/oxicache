{
  "name": "@oxicache/client",
  "version": "0.1.0",
  "description": "TypeScript client for oxicache (Bun runtime)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "check": "tsc --noEmit",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --sourcemap=linked && tsc --emitDeclarationOnly --declaration --noEmit false --outDir dist",
    "test": "bun test"
  }
}
