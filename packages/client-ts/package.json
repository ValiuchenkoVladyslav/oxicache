{
  "name": "@oxicache/client",
  "version": "0.1.0",
  "description": "TypeScript client for oxicache: TCP transport for Bun, HTTP transport for anywhere with fetch",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./transport/tcp": {
      "types": "./dist/transport/tcp.d.ts",
      "bun": "./src/transport/tcp.ts",
      "default": "./dist/transport/tcp.js"
    },
    "./transport/http": {
      "types": "./dist/transport/http.d.ts",
      "bun": "./src/transport/http.ts",
      "default": "./dist/transport/http.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3"
  },
  "devDependencies": {
    "bun-types": "^1.4.0",
    "typescript": "^7.0.2"
  }
}
